// Q5  Why can this user reach this data store? Every route, and the links they all share
// bind: { "userArn": "arn:aws:iam::111122223333:user/dev-user",
//         "storeArn": "arn:aws:s3:::financial-exports", "maxDepth": 6 }
// A link on every route is the smallest fix: remove it and every route closes.
WITH IAMRole, IAMUser, S3Bucket, DynamoDBTable, RDSInstance, SecretsManagerSecret, KMSKey
LET user = FIRST(FOR u IN IAMUser FILTER u.arn == @userArn RETURN u)
LET store = FIRST(FOR s IN S3Bucket FILTER s.arn == @storeArn RETURN s)
LET routes = (
  FOR p IN 1..@maxDepth OUTBOUND K_PATHS user TO store canAssumeRole, canRead, canWrite, canManagePermissions
    FILTER LENGTH(p.edges[* FILTER NOT IS_SAME_COLLECTION("canAssumeRole", CURRENT)]) == 1   // one grant, at the end
    COLLECT route = CONCAT_SEPARATOR(" -> ", p.vertices[*].label), hops = LENGTH(p.edges)
      INTO grants = { access: PARSE_COLLECTION(LAST(p.edges)), policies: LAST(p.edges).policies,
                      names: p.vertices[*].label }
    LET names = FIRST(grants).names
    SORT hops, route
    RETURN { route, hops, access: SORTED_UNIQUE(grants[*].access),
             grantedBy: SORTED_UNIQUE(FLATTEN(grants[*].policies)),
             links: (FOR i IN 0..(LENGTH(names) - 2) RETURN CONCAT(names[i], " -> ", names[i + 1])) }
)
RETURN {
  routes: routes[* RETURN UNSET(CURRENT, "links")],
  onEveryRoute: (FOR link IN FIRST(routes).links
                   FILTER LENGTH(routes[* FILTER link IN CURRENT.links]) == LENGTH(routes) RETURN link)
}
