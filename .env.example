# Local install of the Arango Contextual Data Platform (https://arango.ai/arango-developer-edition/).
# Reach it with `make forward` (a kubectl port-forward) running in another terminal.
# Its certificate is self-signed and doesn't name 127.0.0.1, so certificate checks are off.
ARANGO_URL=https://127.0.0.1:8529
ARANGO_USER=root
ARANGO_PASSWORD=test
ARANGO_DB=aws_access_graph
ARANGO_VERIFY_SSL=false

# Or a managed deployment with a certificate that matches its host:
# ARANGO_URL=https://<deployment>.arangodb.cloud:8529
# ARANGO_PASSWORD=<password>
# ARANGO_VERIFY_SSL=true
# ARANGO_SSL_CERT_PATH=/path/to/ca.pem   # only if its CA isn't in your system trust store
